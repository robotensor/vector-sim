{
  "name": "@vector/sim",
  "version": "0.2.0",
  "description": "The simulator of each Vector skill. Browsers, the environment and experts run the same code.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./skills/bin-picking/src/index.js",
    "./testing": "./skills/bin-picking/test/helpers.js",
    "./skills/*": "./skills/*",
    "./*": "./skills/bin-picking/src/*"
  },
  "bin": {
    "vector-verify": "./skills/bin-picking/bin/verify.mjs",
    "vector-verify-unit": "./skills/bin-picking/bin/verify_unit.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.js skills/*/test/*.test.js"
  },
  "dependencies": {
    "@mujoco/mujoco": "4.0.1"
  },
  "license": "Apache-2.0"
}
